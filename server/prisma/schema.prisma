generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @default(autoincrement()) @id
  email String @unique
  password String
}

model Artist {
  id Int @default(autoincrement()) @id
  name String
  tracks Track[]
  picture String
}

model Track {
  id Int @default(autoincrement()) @id
  title String
  artist Artist[]
  listens Int @default(0)
  picture String
  audio String
  comments Comment[]
}

model Comment {
  id Int @default(autoincrement()) @id
  description String
  track Track @relation(fields: [trackId], references: [id])
  trackId Int
}
